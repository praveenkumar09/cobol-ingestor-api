       IDENTIFICATION DIVISION.
       PROGRAM-ID. POLRNWL.
       AUTHOR. INSURANCE-BATCH-SYSTEMS.
       DATE-WRITTEN. 2024-01-25.
       DATE-COMPILED.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-ISERIES.
       OBJECT-COMPUTER. IBM-ISERIES.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT POLICY-MASTER-FILE
               ASSIGN TO DATABASE-PLCYMST
               ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL
               RECORD KEY IS PMR-POLICY-NUMBER
               FILE STATUS IS WS-POLICY-FS.

           SELECT CUSTOMER-MASTER-FILE
               ASSIGN TO DATABASE-CUSTMST
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS CST-CUSTOMER-NUMBER
               FILE STATUS IS WS-CUSTOMER-FS.

           SELECT RENEWAL-OUTPUT-FILE
               ASSIGN TO DATABASE-RNWLPEND
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-RENEWAL-FS.

           SELECT NOTICE-OUTPUT-FILE
               ASSIGN TO DATABASE-NOTICOUT
               ORGANIZATION IS SEQUENTIAL
               ACCESS MODE IS SEQUENTIAL
               FILE STATUS IS WS-NOTICE-FS.

           SELECT RENEWAL-REPORT
               ASSIGN TO PRINTER-QSYSPRT
               FILE STATUS IS WS-REPORT-FS.

       DATA DIVISION.
       FILE SECTION.

       FD POLICY-MASTER-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 200 CHARACTERS.
       COPY PLCYREC.

       FD CUSTOMER-MASTER-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 250 CHARACTERS.
       COPY CUSTREC.

       FD RENEWAL-OUTPUT-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 250 CHARACTERS.
       01 RENEWAL-OUTPUT-RECORD.
          05 ROR-POLICY-NUMBER          PIC X(10).
          05 ROR-CUSTOMER-NUMBER        PIC X(08).
          05 ROR-RENEWAL-DATE           PIC 9(08).
          05 ROR-CURRENT-PREMIUM        PIC 9(09)V99 COMP-3.
          05 ROR-PROPOSED-PREMIUM       PIC 9(09)V99 COMP-3.
          05 ROR-COVERAGE-AMOUNT        PIC 9(11)V99 COMP-3.
          05 ROR-POLICY-TYPE            PIC X(02).
          05 ROR-RENEWAL-STATUS         PIC X(01).
          05 ROR-AGENT-CODE             PIC X(06).
          05 ROR-BRANCH-CODE            PIC X(04).
          05 ROR-FILLER                 PIC X(188).

       FD NOTICE-OUTPUT-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 300 CHARACTERS.
       01 NOTICE-OUTPUT-RECORD.
          05 NOR-POLICY-NUMBER          PIC X(10).
          05 NOR-CUSTOMER-NAME          PIC X(50).
          05 NOR-EMAIL-ADDRESS          PIC X(50).
          05 NOR-NOTICE-TYPE            PIC X(02).
             88 NOR-RENEWAL-NOTICE          VALUE 'RN'.
             88 NOR-LAPSE-WARNING           VALUE 'LW'.
             88 NOR-LAPSE-NOTICE            VALUE 'LN'.
          05 NOR-NOTICE-DATE            PIC 9(08).
          05 NOR-DUE-DATE               PIC 9(08).
          05 NOR-AMOUNT-DUE             PIC 9(09)V99 COMP-3.
          05 NOR-FILLER                 PIC X(168).

       FD RENEWAL-REPORT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS.
       01 RNW-REPORT-LINE               PIC X(132).

       WORKING-STORAGE SECTION.

       01 WS-FILE-STATUS.
          05 WS-POLICY-FS               PIC X(02) VALUE '00'.
          05 WS-CUSTOMER-FS             PIC X(02) VALUE '00'.
          05 WS-RENEWAL-FS              PIC X(02) VALUE '00'.
          05 WS-NOTICE-FS               PIC X(02) VALUE '00'.
          05 WS-REPORT-FS               PIC X(02) VALUE '00'.

       01 WS-DATE-FIELDS.
          05 WS-TODAY-DATE              PIC 9(08) VALUE ZEROS.
          05 WS-RENEWAL-CUTOFF-DATE     PIC 9(08) VALUE ZEROS.
          05 WS-LAPSE-CUTOFF-DATE       PIC 9(08) VALUE ZEROS.
          05 WS-RENEWAL-WINDOW-DAYS     PIC 9(03) VALUE 030.
          05 WS-GRACE-PERIOD-DAYS       PIC 9(03) VALUE 015.
          05 WS-DATE-DIFF               PIC S9(05) COMP-3 VALUE ZEROS.

       01 WS-COUNTERS.
          05 WS-TOTAL-POLICIES          PIC 9(08) VALUE ZEROS.
          05 WS-RENEWAL-DUE             PIC 9(08) VALUE ZEROS.
          05 WS-LAPSED-TODAY            PIC 9(08) VALUE ZEROS.
          05 WS-NOTICES-GENERATED       PIC 9(08) VALUE ZEROS.
          05 WS-SKIPPED-POLICIES        PIC 9(08) VALUE ZEROS.

       01 WS-CALC-FIELDS.
          05 WS-PREMIUM-INCREASE-PCT    PIC 9(03)V99 COMP-3 VALUE ZEROS.
          05 WS-NEW-PREMIUM             PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-INCREASE-AMOUNT         PIC 9(09)V99 COMP-3 VALUE ZEROS.

       01 WS-FLAGS.
          05 WS-EOF-FLAG                PIC X(01) VALUE 'N'.
             88 WS-END-OF-FILE              VALUE 'Y'.
          05 WS-RENEWAL-DUE-FLAG        PIC X(01) VALUE 'N'.
             88 WS-IS-RENEWAL-DUE            VALUE 'Y'.
          05 WS-LAPSE-FLAG              PIC X(01) VALUE 'N'.
             88 WS-SHOULD-LAPSE              VALUE 'Y'.

       COPY ERRMSGS.

       PROCEDURE DIVISION.

       0000-MAIN SECTION.
       0000-MAIN-PARA.
           PERFORM 1000-INIT-PARA
           PERFORM 2000-PROCESS-POLICY-LOOP-PARA
               UNTIL WS-END-OF-FILE
           PERFORM 8500-WRITE-SUMMARY-PARA
           PERFORM 9000-END-PARA
           STOP RUN.

       1000-INIT SECTION.
       1000-INIT-PARA.
           INITIALIZE WS-FILE-STATUS
           INITIALIZE WS-DATE-FIELDS
           INITIALIZE WS-COUNTERS
           INITIALIZE WS-CALC-FIELDS
           INITIALIZE WS-FLAGS
           MOVE 'POLRNWL'             TO ERR-PROGRAM-NAME
           MOVE FUNCTION CURRENT-DATE TO ERR-TIMESTAMP
           MOVE FUNCTION CURRENT-DATE(1:8) TO WS-TODAY-DATE
           OPEN INPUT  POLICY-MASTER-FILE
           OPEN INPUT  CUSTOMER-MASTER-FILE
           OPEN OUTPUT RENEWAL-OUTPUT-FILE
           OPEN OUTPUT NOTICE-OUTPUT-FILE
           OPEN OUTPUT RENEWAL-REPORT
           IF WS-POLICY-FS NOT = '00'
               MOVE ERR-FILE-OPEN-FAILED TO ERR-RETURN-CODE
               MOVE 'FAILED TO OPEN POLICY MASTER FILE'
                                        TO ERR-MESSAGE-TEXT
               PERFORM 8000-HANDLE-ERROR-PARA
           END-IF
           DISPLAY '** POLRNWL - POLICY RENEWAL BATCH STARTED **'
           DISPLAY '   PROCESSING DATE: ' WS-TODAY-DATE
           DISPLAY '   RENEWAL WINDOW : ' WS-RENEWAL-WINDOW-DAYS ' DAYS'
           READ POLICY-MASTER-FILE NEXT RECORD
               AT END MOVE 'Y'         TO WS-EOF-FLAG
           END-READ.

       2000-PROCESS-POLICY-LOOP SECTION.
       2000-PROCESS-POLICY-LOOP-PARA.
           ADD 1                        TO WS-TOTAL-POLICIES
           MOVE 'N'                     TO WS-RENEWAL-DUE-FLAG
           MOVE 'N'                     TO WS-LAPSE-FLAG
           IF PMR-POLICY-ACTIVE
               PERFORM 2100-CHECK-RENEWAL-DATE-PARA
               IF WS-IS-RENEWAL-DUE
                   PERFORM 3000-LOAD-CUSTOMER-PARA
                   PERFORM 4000-CALC-RENEWAL-PREMIUM-PARA
                   PERFORM 5000-GENERATE-RENEWAL-OUTPUT-PARA
                   PERFORM 6000-GENERATE-NOTICE-PARA
               END-IF
           ELSE IF PMR-POLICY-LAPSED
               ADD 1                    TO WS-SKIPPED-POLICIES
           END-IF
           READ POLICY-MASTER-FILE NEXT RECORD
               AT END MOVE 'Y'         TO WS-EOF-FLAG
           END-READ.

       2100-CHECK-RENEWAL-DATE SECTION.
       2100-CHECK-RENEWAL-DATE-PARA.
           SUBTRACT WS-TODAY-DATE FROM PMR-NEXT-RENEWAL-DATE
               GIVING WS-DATE-DIFF
           EVALUATE TRUE
               WHEN WS-DATE-DIFF BETWEEN 0 AND WS-RENEWAL-WINDOW-DAYS
                   MOVE 'Y'             TO WS-RENEWAL-DUE-FLAG
                   ADD 1                TO WS-RENEWAL-DUE
               WHEN WS-DATE-DIFF < 0
                   IF FUNCTION ABS(WS-DATE-DIFF) > WS-GRACE-PERIOD-DAYS
                       MOVE 'Y'         TO WS-LAPSE-FLAG
                       ADD 1            TO WS-LAPSED-TODAY
                       PERFORM 7000-PROCESS-LAPSE-PARA
                   ELSE
                       MOVE 'Y'         TO WS-RENEWAL-DUE-FLAG
                       ADD 1            TO WS-RENEWAL-DUE
                       MOVE 'LW'        TO NOR-NOTICE-TYPE
                   END-IF
           END-EVALUATE.

       3000-LOAD-CUSTOMER SECTION.
       3000-LOAD-CUSTOMER-PARA.
           MOVE PMR-CUSTOMER-NUMBER     TO CST-CUSTOMER-NUMBER
           READ CUSTOMER-MASTER-FILE
               INVALID KEY
                   MOVE ERR-INVALID-CUSTOMER TO ERR-RETURN-CODE
                   MOVE 'CUSTOMER NOT FOUND DURING RENEWAL'
                                        TO ERR-MESSAGE-TEXT
           END-READ.

       4000-CALC-RENEWAL-PREMIUM SECTION.
       4000-CALC-RENEWAL-PREMIUM-PARA.
           MOVE ZEROS                   TO WS-PREMIUM-INCREASE-PCT
           EVALUATE TRUE
               WHEN PMR-RISK-RATING > 7
                   MOVE 0.15            TO WS-PREMIUM-INCREASE-PCT
               WHEN PMR-RISK-RATING > 5
                   MOVE 0.08            TO WS-PREMIUM-INCREASE-PCT
               WHEN PMR-RISK-RATING > 3
                   MOVE 0.03            TO WS-PREMIUM-INCREASE-PCT
               WHEN OTHER
                   MOVE 0.00            TO WS-PREMIUM-INCREASE-PCT
           END-EVALUATE
           IF PMR-OPEN-CLAIMS-COUNT > 2
               ADD 0.05                 TO WS-PREMIUM-INCREASE-PCT
           END-IF
           MULTIPLY PMR-PREMIUM-AMOUNT BY WS-PREMIUM-INCREASE-PCT
               GIVING WS-INCREASE-AMOUNT
           ADD PMR-PREMIUM-AMOUNT WS-INCREASE-AMOUNT
               GIVING WS-NEW-PREMIUM.

       5000-GENERATE-RENEWAL-OUTPUT SECTION.
       5000-GENERATE-RENEWAL-OUTPUT-PARA.
           MOVE PMR-POLICY-NUMBER       TO ROR-POLICY-NUMBER
           MOVE PMR-CUSTOMER-NUMBER     TO ROR-CUSTOMER-NUMBER
           MOVE PMR-NEXT-RENEWAL-DATE   TO ROR-RENEWAL-DATE
           MOVE PMR-PREMIUM-AMOUNT      TO ROR-CURRENT-PREMIUM
           MOVE WS-NEW-PREMIUM          TO ROR-PROPOSED-PREMIUM
           MOVE PMR-COVERAGE-AMOUNT     TO ROR-COVERAGE-AMOUNT
           MOVE PMR-POLICY-TYPE         TO ROR-POLICY-TYPE
           MOVE 'P'                     TO ROR-RENEWAL-STATUS
           MOVE PMR-AGENT-CODE          TO ROR-AGENT-CODE
           MOVE PMR-BRANCH-CODE         TO ROR-BRANCH-CODE
           WRITE RENEWAL-OUTPUT-RECORD
               INVALID KEY CONTINUE
           END-WRITE.

       6000-GENERATE-NOTICE SECTION.
       6000-GENERATE-NOTICE-PARA.
           MOVE PMR-POLICY-NUMBER       TO NOR-POLICY-NUMBER
           STRING CST-FIRST-NAME ' ' CST-LAST-NAME
               DELIMITED BY SIZE        INTO NOR-CUSTOMER-NAME
           MOVE CST-EMAIL-ADDRESS       TO NOR-EMAIL-ADDRESS
           IF NOR-NOTICE-TYPE = SPACES
               MOVE 'RN'               TO NOR-NOTICE-TYPE
           END-IF
           MOVE WS-TODAY-DATE           TO NOR-NOTICE-DATE
           MOVE PMR-NEXT-RENEWAL-DATE   TO NOR-DUE-DATE
           MOVE WS-NEW-PREMIUM          TO NOR-AMOUNT-DUE
           WRITE NOTICE-OUTPUT-RECORD
               INVALID KEY CONTINUE
           END-WRITE
           ADD 1                        TO WS-NOTICES-GENERATED.

       7000-PROCESS-LAPSE SECTION.
       7000-PROCESS-LAPSE-PARA.
           MOVE 'L'                     TO PMR-POLICY-STATUS
           REWRITE POLICY-MASTER-RECORD
               INVALID KEY
                   MOVE ERR-FILE-WRITE-FAILED TO ERR-RETURN-CODE
                   MOVE 'FAILED TO UPDATE LAPSED POLICY STATUS'
                                        TO ERR-MESSAGE-TEXT
           END-REWRITE
           MOVE PMR-POLICY-NUMBER       TO NOR-POLICY-NUMBER
           MOVE 'LN'                    TO NOR-NOTICE-TYPE
           MOVE WS-TODAY-DATE           TO NOR-NOTICE-DATE
           WRITE NOTICE-OUTPUT-RECORD
               INVALID KEY CONTINUE
           END-WRITE
           ADD 1                        TO WS-NOTICES-GENERATED.

       8000-HANDLE-ERROR SECTION.
       8000-HANDLE-ERROR-PARA.
           DISPLAY '** ERROR IN ' ERR-PROGRAM-NAME ' **'
           DISPLAY '   CODE   : ' ERR-RETURN-CODE
           DISPLAY '   MESSAGE: ' ERR-MESSAGE-TEXT
           IF ERR-SYSTEM-ERROR OR ERR-FILE-OPEN-FAILED
               PERFORM 9000-END-PARA
               STOP RUN
           END-IF.

       8500-WRITE-SUMMARY SECTION.
       8500-WRITE-SUMMARY-PARA.
           WRITE RNW-REPORT-LINE FROM '=== POLICY RENEWAL BATCH SUMMARY ==='
           WRITE RNW-REPORT-LINE FROM
               'TOTAL POLICIES SCANNED  : ' WS-TOTAL-POLICIES
           WRITE RNW-REPORT-LINE FROM
               'RENEWALS DUE            : ' WS-RENEWAL-DUE
           WRITE RNW-REPORT-LINE FROM
               'POLICIES LAPSED TODAY   : ' WS-LAPSED-TODAY
           WRITE RNW-REPORT-LINE FROM
               'NOTICES GENERATED       : ' WS-NOTICES-GENERATED
           WRITE RNW-REPORT-LINE FROM
               'SKIPPED (INACTIVE)      : ' WS-SKIPPED-POLICIES.

       9000-END SECTION.
       9000-END-PARA.
           CLOSE POLICY-MASTER-FILE
           CLOSE CUSTOMER-MASTER-FILE
           CLOSE RENEWAL-OUTPUT-FILE
           CLOSE NOTICE-OUTPUT-FILE
           CLOSE RENEWAL-REPORT
           DISPLAY '** POLRNWL - BATCH PROCESSING COMPLETE **'.