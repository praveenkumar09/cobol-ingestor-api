       IDENTIFICATION DIVISION.
       PROGRAM-ID. PREMINQ.
       AUTHOR. INSURANCE-ACTUARIAL-SYSTEMS.
       DATE-WRITTEN. 2024-01-20.
       DATE-COMPILED.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-ISERIES.
       OBJECT-COMPUTER. IBM-ISERIES.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT POLICY-MASTER-FILE
               ASSIGN TO DATABASE-PLCYMST
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS PMR-POLICY-NUMBER
               FILE STATUS IS WS-POLICY-FS.

           SELECT CUSTOMER-MASTER-FILE
               ASSIGN TO DATABASE-CUSTMST
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS CST-CUSTOMER-NUMBER
               FILE STATUS IS WS-CUSTOMER-FS.

           SELECT PREMIUM-REPORT
               ASSIGN TO PRINTER-QSYSPRT
               FILE STATUS IS WS-REPORT-FS.

       DATA DIVISION.
       FILE SECTION.

       FD POLICY-MASTER-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 200 CHARACTERS.
       COPY PLCYREC.

       FD CUSTOMER-MASTER-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 250 CHARACTERS.
       COPY CUSTREC.

       FD PREMIUM-REPORT
           LABEL RECORDS ARE OMITTED
           RECORD CONTAINS 132 CHARACTERS.
       01 PRM-REPORT-LINE               PIC X(132).

       WORKING-STORAGE SECTION.

       01 WS-FILE-STATUS.
          05 WS-POLICY-FS               PIC X(02) VALUE '00'.
          05 WS-CUSTOMER-FS             PIC X(02) VALUE '00'.
          05 WS-REPORT-FS               PIC X(02) VALUE '00'.

       01 WS-RATE-TABLE.
          05 WS-LIFE-BASE-RATE          PIC 9(01)V9(5) COMP-3 VALUE 0.00250.
          05 WS-HEALTH-BASE-RATE        PIC 9(01)V9(5) COMP-3 VALUE 0.01500.
          05 WS-AUTO-BASE-RATE          PIC 9(01)V9(5) COMP-3 VALUE 0.02000.
          05 WS-HOME-BASE-RATE          PIC 9(01)V9(5) COMP-3 VALUE 0.00800.
          05 WS-DISAB-BASE-RATE         PIC 9(01)V9(5) COMP-3 VALUE 0.01200.
          05 WS-COMM-BASE-RATE          PIC 9(01)V9(5) COMP-3 VALUE 0.03500.

       01 WS-CALC-FIELDS.
          05 WS-BASE-RATE               PIC 9(01)V9(5) COMP-3 VALUE ZEROS.
          05 WS-BASE-PREMIUM            PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-RISK-FACTOR             PIC 9(01)V9(4) COMP-3 VALUE 1.0000.
          05 WS-AGE-FACTOR              PIC 9(01)V9(4) COMP-3 VALUE 1.0000.
          05 WS-CREDIT-FACTOR           PIC 9(01)V9(4) COMP-3 VALUE 1.0000.
          05 WS-TOTAL-FACTOR            PIC 9(02)V9(4) COMP-3 VALUE 1.0000.
          05 WS-ADJUSTED-PREMIUM        PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-MULTI-POLICY-DISC       PIC 9(07)V99 COMP-3 VALUE ZEROS.
          05 WS-LOYALTY-DISCOUNT        PIC 9(07)V99 COMP-3 VALUE ZEROS.
          05 WS-FINAL-PREMIUM           PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-CUSTOMER-AGE            PIC 9(03) COMP-3 VALUE ZEROS.
          05 WS-YEARS-AS-CUSTOMER       PIC 9(03) COMP-3 VALUE ZEROS.
          05 WS-CURRENT-YEAR            PIC 9(04) COMP-3 VALUE ZEROS.
          05 WS-BIRTH-YEAR              PIC 9(04) COMP-3 VALUE ZEROS.
          05 WS-SINCE-YEAR              PIC 9(04) COMP-3 VALUE ZEROS.

       01 WS-INPUT-FIELDS.
          05 WS-POLICY-NUMBER-IN        PIC X(10) VALUE SPACES.

       01 WS-DISPLAY-FIELDS.
          05 WS-BASE-PREM-DISP          PIC $,$$$,$$9.99.
          05 WS-FINAL-PREM-DISP         PIC $,$$$,$$9.99.
          05 WS-DISC-DISP               PIC $,$$$,$$9.99.
          05 WS-COVERAGE-DISP           PIC $$,$$$,$$$,$$9.99.

       COPY ERRMSGS.

       PROCEDURE DIVISION.

       0000-MAIN SECTION.
       0000-MAIN-PARA.
           PERFORM 1000-INIT-PARA
           PERFORM 2000-GET-POLICY-PARA
           PERFORM 3000-LOAD-CUSTOMER-PARA
           PERFORM 4000-CALC-BASE-PREMIUM-PARA
           PERFORM 5000-APPLY-RISK-FACTORS-PARA
           PERFORM 6000-APPLY-DISCOUNTS-PARA
           PERFORM 7000-DISPLAY-PREMIUM-PARA
           PERFORM 9000-END-PARA
           STOP RUN.

       1000-INIT SECTION.
       1000-INIT-PARA.
           INITIALIZE WS-FILE-STATUS
           INITIALIZE WS-CALC-FIELDS
           INITIALIZE WS-INPUT-FIELDS
           MOVE 'PREMINQ'              TO ERR-PROGRAM-NAME
           MOVE FUNCTION CURRENT-DATE TO ERR-TIMESTAMP
           OPEN INPUT POLICY-MASTER-FILE
           OPEN INPUT CUSTOMER-MASTER-FILE
           OPEN OUTPUT PREMIUM-REPORT
           IF WS-POLICY-FS NOT = '00'
               MOVE ERR-FILE-OPEN-FAILED TO ERR-RETURN-CODE
               MOVE 'FAILED TO OPEN POLICY FILE'
                                        TO ERR-MESSAGE-TEXT
               PERFORM 8000-HANDLE-ERROR-PARA
           END-IF
           MOVE FUNCTION CURRENT-DATE(1:4) TO WS-CURRENT-YEAR
           DISPLAY '** PREMINQ - PREMIUM CALCULATION STARTED **'.

       2000-GET-POLICY SECTION.
       2000-GET-POLICY-PARA.
           DISPLAY 'ENTER POLICY NUMBER: '
           ACCEPT WS-POLICY-NUMBER-IN
           MOVE FUNCTION UPPER-CASE(WS-POLICY-NUMBER-IN)
               TO WS-POLICY-NUMBER-IN
           MOVE WS-POLICY-NUMBER-IN     TO PMR-POLICY-NUMBER
           READ POLICY-MASTER-FILE
               INVALID KEY
                   MOVE ERR-RECORD-NOT-FOUND TO ERR-RETURN-CODE
                   MOVE 'POLICY NOT FOUND'   TO ERR-MESSAGE-TEXT
                   PERFORM 8000-HANDLE-ERROR-PARA
               NOT INVALID KEY
                   IF NOT PMR-POLICY-ACTIVE
                       MOVE ERR-INVALID-POLICY TO ERR-RETURN-CODE
                       MOVE 'POLICY IS NOT ACTIVE - CANNOT CALCULATE'
                                        TO ERR-MESSAGE-TEXT
                       PERFORM 8000-HANDLE-ERROR-PARA
                   END-IF
           END-READ.

       3000-LOAD-CUSTOMER SECTION.
       3000-LOAD-CUSTOMER-PARA.
           MOVE PMR-CUSTOMER-NUMBER     TO CST-CUSTOMER-NUMBER
           READ CUSTOMER-MASTER-FILE
               INVALID KEY
                   MOVE ERR-INVALID-CUSTOMER TO ERR-RETURN-CODE
                   MOVE 'CUSTOMER NOT FOUND'  TO ERR-MESSAGE-TEXT
                   PERFORM 8000-HANDLE-ERROR-PARA
           END-READ
           MOVE CST-DATE-OF-BIRTH(1:4) TO WS-BIRTH-YEAR
           SUBTRACT WS-BIRTH-YEAR FROM WS-CURRENT-YEAR
               GIVING WS-CUSTOMER-AGE
           MOVE CST-CUSTOMER-SINCE(1:4) TO WS-SINCE-YEAR
           SUBTRACT WS-SINCE-YEAR FROM WS-CURRENT-YEAR
               GIVING WS-YEARS-AS-CUSTOMER.

       4000-CALC-BASE-PREMIUM SECTION.
       4000-CALC-BASE-PREMIUM-PARA.
           EVALUATE TRUE
               WHEN PMR-LIFE-INSURANCE
                   MOVE WS-LIFE-BASE-RATE   TO WS-BASE-RATE
               WHEN PMR-HEALTH-INSURANCE
                   MOVE WS-HEALTH-BASE-RATE TO WS-BASE-RATE
               WHEN PMR-AUTO-INSURANCE
                   MOVE WS-AUTO-BASE-RATE   TO WS-BASE-RATE
               WHEN PMR-HOME-INSURANCE
                   MOVE WS-HOME-BASE-RATE   TO WS-BASE-RATE
               WHEN PMR-DISABILITY-INS
                   MOVE WS-DISAB-BASE-RATE  TO WS-BASE-RATE
               WHEN PMR-COMMERCIAL-INS
                   MOVE WS-COMM-BASE-RATE   TO WS-BASE-RATE
               WHEN OTHER
                   MOVE 0.02500             TO WS-BASE-RATE
           END-EVALUATE
           MULTIPLY PMR-COVERAGE-AMOUNT BY WS-BASE-RATE
               GIVING WS-BASE-PREMIUM.

       5000-APPLY-RISK-FACTORS SECTION.
       5000-APPLY-RISK-FACTORS-PARA.
           EVALUATE TRUE
               WHEN CST-HIGH-RISK
                   MOVE 1.3500              TO WS-RISK-FACTOR
               WHEN CST-MEDIUM-RISK
                   MOVE 1.1000              TO WS-RISK-FACTOR
               WHEN CST-LOW-RISK
                   MOVE 0.9000              TO WS-RISK-FACTOR
               WHEN OTHER
                   MOVE 1.0000              TO WS-RISK-FACTOR
           END-EVALUATE
           EVALUATE TRUE
               WHEN WS-CUSTOMER-AGE < 25
                   MOVE 1.2500              TO WS-AGE-FACTOR
               WHEN WS-CUSTOMER-AGE > 65
                   MOVE 1.1500              TO WS-AGE-FACTOR
               WHEN OTHER
                   MOVE 1.0000              TO WS-AGE-FACTOR
           END-EVALUATE
           IF CST-CREDIT-SCORE >= 750
               MOVE 0.9500                  TO WS-CREDIT-FACTOR
           ELSE IF CST-CREDIT-SCORE >= 650
               MOVE 1.0000                  TO WS-CREDIT-FACTOR
           ELSE
               MOVE 1.1500                  TO WS-CREDIT-FACTOR
           END-IF
           MULTIPLY WS-RISK-FACTOR BY WS-AGE-FACTOR
               GIVING WS-TOTAL-FACTOR
           MULTIPLY WS-TOTAL-FACTOR BY WS-CREDIT-FACTOR
               GIVING WS-TOTAL-FACTOR
           MULTIPLY WS-BASE-PREMIUM BY WS-TOTAL-FACTOR
               GIVING WS-ADJUSTED-PREMIUM.

       6000-APPLY-DISCOUNTS SECTION.
       6000-APPLY-DISCOUNTS-PARA.
           MOVE ZEROS                   TO WS-MULTI-POLICY-DISC
           MOVE ZEROS                   TO WS-LOYALTY-DISCOUNT
           IF CST-ACTIVE-POLICIES > 1
               MULTIPLY WS-ADJUSTED-PREMIUM BY 0.03
                   GIVING WS-MULTI-POLICY-DISC
           END-IF
           IF WS-YEARS-AS-CUSTOMER >= PC-LOYALTY-DISCOUNT-YEARS
               MULTIPLY WS-ADJUSTED-PREMIUM BY 0.05
                   GIVING WS-LOYALTY-DISCOUNT
           END-IF
           SUBTRACT WS-MULTI-POLICY-DISC FROM WS-ADJUSTED-PREMIUM
               GIVING WS-FINAL-PREMIUM
           SUBTRACT WS-LOYALTY-DISCOUNT FROM WS-FINAL-PREMIUM
               GIVING WS-FINAL-PREMIUM
           IF WS-FINAL-PREMIUM < ZEROS
               MOVE ZEROS               TO WS-FINAL-PREMIUM
           END-IF.

       7000-DISPLAY-PREMIUM SECTION.
       7000-DISPLAY-PREMIUM-PARA.
           MOVE WS-BASE-PREMIUM         TO WS-BASE-PREM-DISP
           MOVE WS-FINAL-PREMIUM        TO WS-FINAL-PREM-DISP
           MOVE WS-MULTI-POLICY-DISC    TO WS-DISC-DISP
           MOVE PMR-COVERAGE-AMOUNT     TO WS-COVERAGE-DISP
           WRITE PRM-REPORT-LINE FROM '=== PREMIUM CALCULATION REPORT ==='
           WRITE PRM-REPORT-LINE FROM
               'POLICY NUMBER    : ' PMR-POLICY-NUMBER
           WRITE PRM-REPORT-LINE FROM
               'COVERAGE AMOUNT  : ' WS-COVERAGE-DISP
           WRITE PRM-REPORT-LINE FROM
               'BASE PREMIUM     : ' WS-BASE-PREM-DISP
           WRITE PRM-REPORT-LINE FROM
               'MULTI-POLICY DISC: ' WS-DISC-DISP
           WRITE PRM-REPORT-LINE FROM
               'FINAL PREMIUM    : ' WS-FINAL-PREM-DISP
           MOVE WS-FINAL-PREMIUM        TO PMR-PREMIUM-AMOUNT
           REWRITE POLICY-MASTER-RECORD
               INVALID KEY
                   MOVE ERR-FILE-WRITE-FAILED TO ERR-RETURN-CODE
                   MOVE 'FAILED TO UPDATE POLICY PREMIUM'
                                        TO ERR-MESSAGE-TEXT
                   PERFORM 8000-HANDLE-ERROR-PARA
           END-REWRITE.

       8000-HANDLE-ERROR SECTION.
       8000-HANDLE-ERROR-PARA.
           DISPLAY '** ERROR IN ' ERR-PROGRAM-NAME ' **'
           DISPLAY '   CODE   : ' ERR-RETURN-CODE
           DISPLAY '   MESSAGE: ' ERR-MESSAGE-TEXT
           IF ERR-SYSTEM-ERROR OR ERR-FILE-OPEN-FAILED
               PERFORM 9000-END-PARA
               STOP RUN
           END-IF.

       9000-END SECTION.
       9000-END-PARA.
           CLOSE POLICY-MASTER-FILE
           CLOSE CUSTOMER-MASTER-FILE
           CLOSE PREMIUM-REPORT
           DISPLAY '** PREMINQ - PREMIUM CALCULATION COMPLETE **'.