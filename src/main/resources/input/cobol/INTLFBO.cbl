       IDENTIFICATION DIVISION.
       PROGRAM-ID. INTLFBO.
       AUTHOR. INTEGRAL-LIFE-PRODUCT-TEAM.
       DATE-WRITTEN. 2023-09-01.
       DATE-COMPILED.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-ISERIES.
       OBJECT-COMPUTER. IBM-ISERIES.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INTLF-POLICY-FILE
               ASSIGN TO DATABASE-INTLFMST
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS ILP-POLICY-NUMBER
               FILE STATUS IS WS-INTLF-FS.

           SELECT MORTALITY-TABLE-FILE
               ASSIGN TO DATABASE-MORTLTBL
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS MTB-LOOKUP-KEY
               FILE STATUS IS WS-MORTALITY-FS.

           SELECT INTEREST-RATE-FILE
               ASSIGN TO DATABASE-INTRTTBL
               ORGANIZATION IS INDEXED
               ACCESS MODE IS RANDOM
               RECORD KEY IS IRT-EFFECTIVE-DATE
               FILE STATUS IS WS-INTRT-FS.

       DATA DIVISION.
       FILE SECTION.

       FD INTLF-POLICY-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 280 CHARACTERS.
       COPY INTLFREC.

       FD MORTALITY-TABLE-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 50 CHARACTERS.
       01 MORTALITY-TABLE-RECORD.
          05 MTB-LOOKUP-KEY.
             10 MTB-AGE                PIC 9(03).
             10 MTB-RISK-CLASS         PIC X(02).
          05 MTB-MORTALITY-RATE        PIC 9(02)V9(6) COMP-3.
          05 MTB-EXPECTED-DEATHS       PIC 9(05)V9(4) COMP-3.
          05 MTB-FILLER                PIC X(30).

       FD INTEREST-RATE-FILE
           LABEL RECORDS ARE STANDARD
           RECORD CONTAINS 30 CHARACTERS.
       01 INTEREST-RATE-RECORD.
          05 IRT-EFFECTIVE-DATE        PIC 9(08).
          05 IRT-GUARANTEED-RATE       PIC 9(02)V9(4) COMP-3.
          05 IRT-CURRENT-RATE          PIC 9(02)V9(4) COMP-3.
          05 IRT-LOAN-RATE             PIC 9(02)V9(4) COMP-3.
          05 IRT-FILLER                PIC X(06).

       WORKING-STORAGE SECTION.

       01 WS-FILE-STATUS.
          05 WS-INTLF-FS               PIC X(02) VALUE '00'.
          05 WS-MORTALITY-FS           PIC X(02) VALUE '00'.
          05 WS-INTRT-FS               PIC X(02) VALUE '00'.

       01 WS-LINKAGE-POLICY-IN         PIC X(10).
       01 WS-LINKAGE-RESPONSE          PIC X(110).

       01 WS-CALC-FIELDS.
          05 WS-YEARS-ELAPSED          PIC 9(03) COMP-3 VALUE ZEROS.
          05 WS-SURRENDER-FACTOR       PIC 9(02)V9(4) COMP-3 VALUE ZEROS.
          05 WS-CSV-BASE               PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-MORTALITY-COST         PIC 9(07)V99 COMP-3 VALUE ZEROS.
          05 WS-INTEREST-CREDIT        PIC 9(07)V99 COMP-3 VALUE ZEROS.
          05 WS-ACCUMULATED-VALUE      PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-NET-SURRENDER          PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-AD-BENEFIT             PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-WAIVER-BENEFIT         PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-TOTAL-DEATH-BENEFIT    PIC 9(09)V99 COMP-3 VALUE ZEROS.
          05 WS-CURRENT-INTEREST-RATE  PIC 9(02)V9(4) COMP-3 VALUE ZEROS.
          05 WS-CURRENT-MORTALITY-RATE PIC 9(02)V9(6) COMP-3 VALUE ZEROS.
          05 WS-LOAN-INTEREST          PIC 9(07)V99 COMP-3 VALUE ZEROS.
          05 WS-AVAILABLE-LOAN         PIC 9(09)V99 COMP-3 VALUE ZEROS.

       01 WS-CURRENT-DATE-FIELDS.
          05 WS-TODAY                  PIC 9(08) VALUE ZEROS.
          05 WS-CURRENT-YEAR           PIC 9(04) VALUE ZEROS.
          05 WS-ISSUE-YEAR             PIC 9(04) VALUE ZEROS.

       COPY ERRMSGS.

       PROCEDURE DIVISION.

       0000-MAIN SECTION.
       0000-MAIN-PARA.
           DISPLAY 'INTLFBO LOADED - CALL VIA ENTRY POINTS'
           STOP RUN.

       1000-INIT SECTION.
       1000-INIT-PARA.
           INITIALIZE WS-FILE-STATUS
           INITIALIZE WS-CALC-FIELDS
           INITIALIZE WS-CURRENT-DATE-FIELDS
           MOVE FUNCTION CURRENT-DATE(1:8) TO WS-TODAY
           MOVE WS-TODAY(1:4)           TO WS-CURRENT-YEAR
           OPEN INPUT INTLF-POLICY-FILE
           OPEN INPUT MORTALITY-TABLE-FILE
           OPEN INPUT INTEREST-RATE-FILE
           IF WS-INTLF-FS NOT = '00'
               MOVE ERR-FILE-OPEN-FAILED TO ERR-RETURN-CODE
               MOVE 'FAILED TO OPEN INTEGRAL LIFE POLICY FILE'
                                        TO ERR-MESSAGE-TEXT
               PERFORM 8000-HANDLE-ERROR-PARA
           END-IF.

       2000-GET-POLICY SECTION.
       2000-GET-POLICY-PARA.
           MOVE WS-LINKAGE-POLICY-IN   TO ILP-POLICY-NUMBER
           READ INTLF-POLICY-FILE
               INVALID KEY
                   MOVE ILR-POLICY-NOT-FOUND TO ILR-RETURN-CODE
                   MOVE 'INTEGRAL LIFE POLICY NOT FOUND ON FILE'
                                        TO ILR-MESSAGE
               NOT INVALID KEY
                   MOVE ILR-SUCCESS    TO ILR-RETURN-CODE
                   MOVE SPACES         TO ILR-MESSAGE
           END-READ.

       3000-CALC-SURRENDER-VALUE SECTION.
       3000-CALC-SURRENDER-VALUE-PARA.
           IF NOT ILP-INFORCE AND NOT ILP-PAID-UP
               MOVE ILR-SURRENDER-NOT-ALLOWED TO ILR-RETURN-CODE
               MOVE 'SURRENDER NOT PERMITTED - POLICY NOT IN FORCE'
                                        TO ILR-MESSAGE
               GO TO 3000-CALC-SURRENDER-VALUE-EXIT
           END-IF
           MOVE ILP-ISSUE-DATE(1:4)    TO WS-ISSUE-YEAR
           SUBTRACT WS-ISSUE-YEAR FROM WS-CURRENT-YEAR
               GIVING WS-YEARS-ELAPSED
           EVALUATE TRUE
               WHEN WS-YEARS-ELAPSED < 3
                   MOVE 0.7500         TO WS-SURRENDER-FACTOR
               WHEN WS-YEARS-ELAPSED < 5
                   MOVE 0.8500         TO WS-SURRENDER-FACTOR
               WHEN WS-YEARS-ELAPSED < 7
                   MOVE 0.9000         TO WS-SURRENDER-FACTOR
               WHEN WS-YEARS-ELAPSED < 10
                   MOVE 0.9500         TO WS-SURRENDER-FACTOR
               WHEN OTHER
                   MOVE 1.0000         TO WS-SURRENDER-FACTOR
           END-EVALUATE
           MULTIPLY ILP-CASH-VALUE BY WS-SURRENDER-FACTOR
               GIVING WS-CSV-BASE
           ADD ILP-DIVIDENDS-ACCUMULATED TO WS-CSV-BASE
               GIVING WS-NET-SURRENDER
           SUBTRACT ILP-LOAN-BALANCE FROM WS-NET-SURRENDER
               GIVING WS-NET-SURRENDER
           IF WS-NET-SURRENDER < ZEROS
               MOVE ZEROS              TO WS-NET-SURRENDER
           END-IF
           MOVE WS-NET-SURRENDER       TO ILR-CALCULATED-VALUE
           MOVE WS-TODAY               TO ILR-EFFECTIVE-DATE
           MOVE ILR-SUCCESS            TO ILR-RETURN-CODE
           MOVE 'SURRENDER VALUE CALCULATED SUCCESSFULLY'
                                        TO ILR-MESSAGE.
       3000-CALC-SURRENDER-VALUE-EXIT.
           EXIT.

       4000-CALC-DEATH-BENEFIT SECTION.
       4000-CALC-DEATH-BENEFIT-PARA.
           IF NOT ILP-INFORCE AND NOT ILP-PAID-UP
               MOVE ILR-POLICY-INACTIVE TO ILR-RETURN-CODE
               MOVE 'DEATH BENEFIT NOT PAYABLE - POLICY INACTIVE'
                                        TO ILR-MESSAGE
               GO TO 4000-CALC-DEATH-BENEFIT-EXIT
           END-IF
           MOVE ILP-FACE-AMOUNT        TO WS-TOTAL-DEATH-BENEFIT
           ADD ILP-DIVIDENDS-ACCUMULATED TO WS-TOTAL-DEATH-BENEFIT
           IF ILP-AD-RIDER-YES
               MULTIPLY ILP-FACE-AMOUNT BY 2
                   GIVING WS-AD-BENEFIT
               MOVE WS-AD-BENEFIT      TO WS-TOTAL-DEATH-BENEFIT
           END-IF
           SUBTRACT ILP-LOAN-BALANCE FROM WS-TOTAL-DEATH-BENEFIT
           IF WS-TOTAL-DEATH-BENEFIT < ILP-FACE-AMOUNT
               MOVE ILP-FACE-AMOUNT    TO WS-TOTAL-DEATH-BENEFIT
           END-IF
           MOVE WS-TOTAL-DEATH-BENEFIT TO ILR-CALCULATED-VALUE
           MOVE WS-TODAY               TO ILR-EFFECTIVE-DATE
           MOVE ILR-SUCCESS            TO ILR-RETURN-CODE
           MOVE 'DEATH BENEFIT CALCULATED SUCCESSFULLY'
                                        TO ILR-MESSAGE.
       4000-CALC-DEATH-BENEFIT-EXIT.
           EXIT.

       5000-APPLY-PREMIUM SECTION.
       5000-APPLY-PREMIUM-PARA.
           IF NOT ILP-INFORCE
               MOVE ILR-POLICY-INACTIVE TO ILR-RETURN-CODE
               MOVE 'CANNOT APPLY PREMIUM - POLICY NOT IN FORCE'
                                        TO ILR-MESSAGE
               GO TO 5000-APPLY-PREMIUM-EXIT
           END-IF
           PERFORM 5100-LOAD-INTEREST-RATE-PARA
           MULTIPLY ILP-CASH-VALUE BY WS-CURRENT-INTEREST-RATE
               GIVING WS-INTEREST-CREDIT
           ADD WS-INTEREST-CREDIT       TO ILP-CASH-VALUE
           PERFORM 5200-DEDUCT-MORTALITY-COST-PARA
           SUBTRACT WS-MORTALITY-COST FROM ILP-CASH-VALUE
           ADD ILP-ANNUAL-PREMIUM       TO ILP-CASH-VALUE
           ADD ILP-ANNUAL-PREMIUM       TO ILP-PREMIUM-PAID-TO-DATE
           MOVE WS-TODAY               TO ILP-LAST-PREMIUM-DATE
           MOVE 'C'                    TO ILP-PREMIUM-STATUS
           REWRITE INTEGRAL-LIFE-POLICY
               INVALID KEY
                   MOVE ERR-FILE-WRITE-FAILED TO ERR-RETURN-CODE
                   MOVE 'FAILED TO UPDATE INTEGRAL LIFE POLICY AFTER PREMIUM'
                                        TO ERR-MESSAGE-TEXT
                   PERFORM 8000-HANDLE-ERROR-PARA
           END-REWRITE
           MOVE ILP-CASH-VALUE         TO ILR-CALCULATED-VALUE
           MOVE WS-TODAY               TO ILR-EFFECTIVE-DATE
           MOVE ILR-SUCCESS            TO ILR-RETURN-CODE
           MOVE 'PREMIUM APPLIED AND CASH VALUE UPDATED'
                                        TO ILR-MESSAGE.
       5000-APPLY-PREMIUM-EXIT.
           EXIT.

       5100-LOAD-INTEREST-RATE SECTION.
       5100-LOAD-INTEREST-RATE-PARA.
           MOVE WS-TODAY               TO IRT-EFFECTIVE-DATE
           READ INTEREST-RATE-FILE
               INVALID KEY
                   MOVE 0.0400         TO WS-CURRENT-INTEREST-RATE
               NOT INVALID KEY
                   MOVE IRT-CURRENT-RATE TO WS-CURRENT-INTEREST-RATE
           END-READ.

       5200-DEDUCT-MORTALITY-COST SECTION.
       5200-DEDUCT-MORTALITY-COST-PARA.
           MOVE ILP-ATTAINED-AGE       TO MTB-AGE
           MOVE ILP-RISK-CLASS         TO MTB-RISK-CLASS
           READ MORTALITY-TABLE-FILE
               INVALID KEY
                   MOVE 0.001000       TO WS-CURRENT-MORTALITY-RATE
               NOT INVALID KEY
                   MOVE MTB-MORTALITY-RATE TO WS-CURRENT-MORTALITY-RATE
           END-READ
           MULTIPLY ILP-FACE-AMOUNT BY WS-CURRENT-MORTALITY-RATE
               GIVING WS-MORTALITY-COST.

       6000-GET-LOAN-AVAILABILITY SECTION.
       6000-GET-LOAN-AVAILABILITY-PARA.
           IF NOT ILP-INFORCE AND NOT ILP-PAID-UP
               MOVE ILR-POLICY-INACTIVE TO ILR-RETURN-CODE
               MOVE 'POLICY LOANS NOT AVAILABLE - POLICY INACTIVE'
                                        TO ILR-MESSAGE
               GO TO 6000-GET-LOAN-AVAILABILITY-EXIT
           END-IF
           MULTIPLY ILP-CASH-VALUE BY 0.90
               GIVING WS-AVAILABLE-LOAN
           SUBTRACT ILP-LOAN-BALANCE FROM WS-AVAILABLE-LOAN
           IF WS-AVAILABLE-LOAN < ZEROS
               MOVE ZEROS              TO WS-AVAILABLE-LOAN
               MOVE ILR-LOAN-EXCEEDS-VALUE TO ILR-RETURN-CODE
               MOVE 'EXISTING LOAN BALANCE EXCEEDS 90% OF CASH VALUE'
                                        TO ILR-MESSAGE
           ELSE
               MOVE WS-AVAILABLE-LOAN  TO ILR-CALCULATED-VALUE
               MOVE ILR-SUCCESS        TO ILR-RETURN-CODE
               MOVE 'AVAILABLE LOAN AMOUNT CALCULATED'
                                        TO ILR-MESSAGE
           END-IF.
       6000-GET-LOAN-AVAILABILITY-EXIT.
           EXIT.

       8000-HANDLE-ERROR SECTION.
       8000-HANDLE-ERROR-PARA.
           DISPLAY '** ERROR IN INTLFBO: ' ERR-RETURN-CODE
           DISPLAY '   ' ERR-MESSAGE-TEXT
           IF ERR-SYSTEM-ERROR OR ERR-FILE-OPEN-FAILED
               PERFORM 9000-END-PARA
               STOP RUN
           END-IF.

       9000-END SECTION.
       9000-END-PARA.
           CLOSE INTLF-POLICY-FILE
           CLOSE MORTALITY-TABLE-FILE
           CLOSE INTEREST-RATE-FILE.

       ENTRY 'GETINTLFPOL' USING WS-LINKAGE-POLICY-IN
                                  WS-LINKAGE-RESPONSE.
           PERFORM 1000-INIT-PARA
           PERFORM 2000-GET-POLICY-PARA
           MOVE INTEGRAL-LIFE-RESPONSE TO WS-LINKAGE-RESPONSE
           PERFORM 9000-END-PARA.

       ENTRY 'CALCSURRVAL' USING WS-LINKAGE-POLICY-IN
                                  WS-LINKAGE-RESPONSE.
           PERFORM 1000-INIT-PARA
           PERFORM 2000-GET-POLICY-PARA
           IF ILR-SUCCESS
               PERFORM 3000-CALC-SURRENDER-VALUE-PARA
           END-IF
           MOVE INTEGRAL-LIFE-RESPONSE TO WS-LINKAGE-RESPONSE
           PERFORM 9000-END-PARA.

       ENTRY 'CALCDEATHBFT' USING WS-LINKAGE-POLICY-IN
                                   WS-LINKAGE-RESPONSE.
           PERFORM 1000-INIT-PARA
           PERFORM 2000-GET-POLICY-PARA
           IF ILR-SUCCESS
               PERFORM 4000-CALC-DEATH-BENEFIT-PARA
           END-IF
           MOVE INTEGRAL-LIFE-RESPONSE TO WS-LINKAGE-RESPONSE
           PERFORM 9000-END-PARA.

       ENTRY 'APPLYPREM' USING WS-LINKAGE-POLICY-IN
                                WS-LINKAGE-RESPONSE.
           PERFORM 1000-INIT-PARA
           PERFORM 2000-GET-POLICY-PARA
           IF ILR-SUCCESS
               PERFORM 5000-APPLY-PREMIUM-PARA
           END-IF
           MOVE INTEGRAL-LIFE-RESPONSE TO WS-LINKAGE-RESPONSE
           PERFORM 9000-END-PARA.

       ENTRY 'GETLOANAVAIL' USING WS-LINKAGE-POLICY-IN
                                   WS-LINKAGE-RESPONSE.
           PERFORM 1000-INIT-PARA
           PERFORM 2000-GET-POLICY-PARA
           IF ILR-SUCCESS
               PERFORM 6000-GET-LOAN-AVAILABILITY-PARA
           END-IF
           MOVE INTEGRAL-LIFE-RESPONSE TO WS-LINKAGE-RESPONSE
           PERFORM 9000-END-PARA.