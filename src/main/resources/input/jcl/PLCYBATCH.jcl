//PLCYBATCH JOB (ACCT001),'POLICY BATCH PROCESS',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=4096K
//STEP010   EXEC PGM=PLCYINQ,
//             PARM='BATCH'
//SYSOUT    DD   SYSOUT=*
//PLCYMST   DD   DSN=INS.PROD.POLICY.MASTER,
//             DISP=SHR
//CUSTMST   DD   DSN=INS.PROD.CUSTOMER.MASTER,
//             DISP=SHR
//PLCYRPT   DD   SYSOUT=*
//SYSIN     DD   *
PROCESS-MODE=BATCH
START-DATE=CURRENT
END-DATE=CURRENT+30
/*
//STEP020   EXEC PGM=POLRNWL,
//             COND=(0,NE,STEP010)
//SYSOUT    DD   SYSOUT=*
//PLCYMST   DD   DSN=INS.PROD.POLICY.MASTER,
//             DISP=SHR
//RNWLFILE  DD   DSN=INS.PROD.RENEWAL.PENDING,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5),RLSE),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=20000)
//NOTICEFILE DD   DSN=INS.PROD.RENEWAL.NOTICES,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,2),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=30000)
//SYSIN     DD   *
RENEWAL-WINDOW-DAYS=30
GRACE-PERIOD-DAYS=15
/*
//STEP030   EXEC PGM=PREMINQ,
//             COND=(0,NE,STEP020)
//SYSOUT    DD   SYSOUT=*
//PLCYMST   DD   DSN=INS.PROD.POLICY.MASTER,
//             DISP=SHR
//CUSTMST   DD   DSN=INS.PROD.CUSTOMER.MASTER,
//             DISP=SHR
//PREMRPT   DD   SYSOUT=*
//SYSIN     DD   *
CALC-MODE=RENEWAL
RATE-TABLE=2024
/*
//STEP040   EXEC PGM=IEBGENER,
//             COND=(0,NE,STEP030)
//SYSUT1    DD   DSN=INS.PROD.RENEWAL.PENDING,
//             DISP=SHR
//SYSUT2    DD   DSN=INS.ARCHIVE.RENEWAL.&&TODAY,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5),RLSE)
//SYSIN     DD   DUMMY
//SYSOUT    DD   SYSOUT=*