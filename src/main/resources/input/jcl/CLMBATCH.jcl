a//CLMBATCH  JOB (ACCT002),'CLAIMS BATCH PROCESS',
//             CLASS=B,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID,REGION=8192K
//STEP010   EXEC PGM=CLMPRC,
//             PARM='VALIDATE-ONLY'
//SYSOUT    DD   SYSOUT=*
//CLMINPT   DD   DSN=INS.PROD.CLAIMS.INPUT,
//             DISP=SHR
//CLMMST    DD   DSN=INS.PROD.CLAIMS.MASTER,
//             DISP=SHR
//PLCYMST   DD   DSN=INS.PROD.POLICY.MASTER,
//             DISP=SHR
//CUSTMST   DD   DSN=INS.PROD.CUSTOMER.MASTER,
//             DISP=SHR
//CLMERR    DD   DSN=INS.PROD.CLAIMS.ERRORS,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,2),RLSE),
//             DCB=(RECFM=FB,LRECL=300,BLKSIZE=30000)
//SYSIN     DD   *
PROCESS-DATE=CURRENT
CLAIM-TYPE=ALL
VALIDATE-ONLY=Y
/*
//STEP020   EXEC PGM=CLMPRC,
//             PARM='PROCESS',
//             COND=(0,NE,STEP010)
//SYSOUT    DD   SYSOUT=*
//CLMINPT   DD   DSN=INS.PROD.CLAIMS.INPUT,
//             DISP=SHR
//CLMMST    DD   DSN=INS.PROD.CLAIMS.MASTER,
//             DISP=SHR
//PLCYMST   DD   DSN=INS.PROD.POLICY.MASTER,
//             DISP=SHR
//PAYQUEUE  DD   DSN=INS.PROD.PAYMENT.QUEUE,
//             DISP=(MOD,CATLG,DELETE),
//             SPACE=(CYL,(20,10),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=10000)
//CLMRPT    DD   SYSOUT=*
//SYSIN     DD   *
PROCESS-DATE=CURRENT
AUTO-APPROVE-LIMIT=500.00
THIRD-PARTY-CHECK=Y
/*
//STEP030   EXEC PGM=SORT,
//             COND=(0,NE,STEP020)
//SYSOUT    DD   SYSOUT=*
//SORTIN    DD   DSN=INS.PROD.PAYMENT.QUEUE,
//             DISP=SHR
//SORTOUT   DD   DSN=INS.PROD.PAYMENT.SORTED,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(20,10),RLSE)
//SYSIN     DD   *
  SORT FIELDS=(13,1,CH,A,1,12,CH,A)
  OUTREC FIELDS=(1,100)
/*